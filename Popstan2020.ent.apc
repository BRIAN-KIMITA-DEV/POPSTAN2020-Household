{Application 'POPSTAN2020' logic file generated by CSPro}
PROC GLOBAL
//Declared array variables
numeric calculatedChildrenDied;
array string labels(100);
array numeric codes(100);
array string codesString(100);
array string householdMembersArray(30, 3);
string photoFilename;
file tempFile;
function isChildbearingWoman(index)
    if SEX(index) = 2 and AGE(index) >= 12 and AGE(index) <> 999 then
        isChildbearingWoman = 1;
    else
        isChildbearingWoman = 0;
    endif;
end;
function createMothersValueSet(excludeIndex)
    numeric indexRoster;
    numeric nextEntryValueSet = 1;
   do indexRoster = 1 while indexRoster <= totocc(HOUSEHOLD_MEMBERS_ROSTER)
        if isChildbearingWoman(indexRoster) = 1 and indexRoster <> excludeIndex then
            labels(nextEntryValueSet) = NAME(indexRoster);
            codes(nextEntryValueSet) = indexRoster;
            nextEntryValueSet = nextEntryValueSet + 1;
        endif;
    enddo;

    createMothersValueSet = nextEntryValueSet;
end;
function hello()
 errmsg("Hello");
end;
function pickFromHouseholdRoster()
    numeric i;
   do i = 1 while i <= totocc(HOUSEHOLD_MEMBERS_ROSTER)
        householdMembersArray(i, 1) = strip(NAME(i));
        householdMembersArray(i, 2) = getlabel(SEX, visualvalue(SEX(i)));
        if visualvalue(SEX(i)) = 1 then
            householdMembersArray(i, 3) =getlabel(RELATIONSHIP_MALE,visualvalue(RELATIONSHIP(i)));
          else
            householdMembersArray(i, 3) = getlabel(RELATIONSHIP_FEMALE,visualvalue(RELATIONSHIP(i)));
        endif;
    enddo;

    householdMembersArray(i, 1) = "";

    numeric picked = showarray(householdMembersArray,title("Name", "Sex", "Relationship"));
    pickFromHouseholdRoster = picked;
end;
function goto()
    numeric section = accept("Go to?","Identification","Household members","Demographics","Education","Housing","Deaths","Fertility","Possessions");
    if section = 1 then
        move to IDENTIFICATION_FORM advance;
    elseif section = 2 then
        numeric index = pickFromHouseholdRoster();
          if index > 0 then
              move to NAME(index) advance;
          endif;
    elseif section = 3 then
        move to DEMOGRAPHICS_FORM advance;
    elseif section = 4 then
       move to EDUCATION_FORM advance;
    elseif section = 5 then
        move to HOUSING_FORM advance;
    elseif section = 6 then
        move to DEATHS_FORM advance;
    elseif section = 7 then
        move to FERTILITY_FORM advance;
    elseif section = 8 then
        move to POSSESSION_FORM advance;
    endif;
end;
function household_summary()

    // Variables used to calculate the household summary.
    numeric i;
    numeric totalMembers = 0;
    numeric women = 0;
    numeric men = 0;
  // Examine each household member.
    do i = 1 while i <= totocc(HOUSEHOLD_MEMBERS_ROSTER)

        // Count only rows with a member's name.
        if strip(NAME(i)) <> "" then

            totalMembers = totalMembers + 1;

            // Sex: 1 = Male, 2 = Female.
            if visualvalue(SEX(i)) = 1 then
                men = men + 1;
            elseif visualvalue(SEX(i)) = 2 then
                women = women + 1;
            endif;

        endif;

    enddo;

    // Display the household summary.
    errmsg("Head of Household: %s, Total Members: %d, Women: %d, Men: %d",strip(NAME(1)), totalMembers, women, men);

end;
// Launch the Windows and Android Calculator.
function showCalculator()

    if getos() = 10 then

        // Windows
        execsystem("calc.exe");

    elseif getos() = 20 then

        // Android: Try the Google calculator first.
        if execsystem("app:com.google.android.calculator") <> 1 then

            // Try the alternative Android calculator.
            if execsystem("app:com.android.calculator2") <> 1 then

                errmsg("Unable to launch calculator.");

            endif;

        endif;

    else

        errmsg("Calculator not supported on this system");

    endif;

end;
// Display an image using its default viewer.
function showEAMap()
    execsystem(maketext("view:%s/resources/maps/EAMap%03d.jpg",pathname(Application),ENUMERATION_AREA));
end;
// Capture current household location using GPS.
function getGPS()
gps(open);

    if gps(read, 60) then

        if setvalue("LATITUDE", gps(latitude)) = 1 and
           setvalue("LONGITUDE", gps(longitude)) = 1 then

            errmsg("GPS coordinates saved successfully.");

        else

            errmsg("Unable to save GPS coordinates.");

        endif;

    else

        errmsg("GPS signal could not be acquired");

    endif;

    gps(close);

end;
// Display household GPS point on map.
function showHouseholdOnMap()


    if getvalue("LATITUDE") <> notappl and getvalue("LONGITUDE") <> notappl then

        execsystem(maketext("gps:%f,%f", getvalue("LATITUDE"), getvalue("LONGITUDE")));

    else

        errmsg("No household GPS coordinates have been saved.");

    endif;

end;
// Write out and display household summary report.
// Write out and display household summary report.
function showHouseholdReport()

    string reportFilename = maketext("%sreport_%d_%02d_%03d_%d_%03d.txt",pathname(Application),visualvalue(PROVINCE),visualvalue(DISTRICT),visualvalue(ENUMERATION_AREA),visualvalue(AREA_TYPE),visualvalue(HOUSEHOLD_NUMBER));

    // Delete the previous report if it exists.
    if fileexist(reportFilename) then
        filedelete(reportFilename);
    endif;

    // Open a fresh report file.
    setfile(tempFile, reportFilename);

    // Report heading.
    filewrite(tempFile, "Household Summary Report");
    filewrite(tempFile, "------------------------");
    filewrite(tempFile, "");

    // Household identification details.
    filewrite(tempFile,
        "Province %d District %d EA %d Area type %d Household Number %d",
        visualvalue(PROVINCE),
        visualvalue(DISTRICT),
        visualvalue(ENUMERATION_AREA),
        visualvalue(AREA_TYPE),
        visualvalue(HOUSEHOLD_NUMBER));

    filewrite(tempFile, "");

    // Household members heading.
    filewrite(tempFile, "Household Members:");
    filewrite(tempFile, "");
    filewrite(tempFile, "Name                           Sex    Age  Relationship");
    filewrite(tempFile, "----                           ---    ---  ------------");

    // Write current household members.
    do numeric i = 1 while i <= totocc(HOUSEHOLD_MEMBERS_ROSTER)

        filewrite(tempFile, "%s %-6s %3d  %s",NAME(i), getlabel(SEX, visualvalue(SEX(i))), visualvalue(AGE(i)), getlabel(RELATIONSHIP_VS1, visualvalue(RELATIONSHIP(i))));

    enddo;

    // Close the report file.
    close(tempFile);

    // Display the report.
    if getos() = 20 then

        // Android.
        execsystem(maketext("view:%s", reportFilename));

    elseif getos() = 10 then

        // Windows.
        execsystem(maketext("explorer.exe %s", reportFilename));

    endif;

end;
