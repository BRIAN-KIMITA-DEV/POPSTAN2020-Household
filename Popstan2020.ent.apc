PROC POPSTAN2020_FF
preproc
setproperty(END_HOUR, "CanEnterNotAppl", "NoConfirm");
setproperty(END_MINUTE, "CanEnterNotAppl", "NoConfirm");
setproperty(INTERVIEW_START_TIMESTAMP, "CanEnterNotAppl", "NoConfirm");
setproperty(INTERVIEW_END_TIMESTAMP, "CanEnterNotAppl", "NoConfirm");
setproperty(INTERVIEW_DURATION_MINUTES, "CanEnterNotAppl", "NoConfirm");
do numeric i = 1 while i <= totocc(HOUSEHOLD_MEMBERS_ROSTER)
setocclabel(HOUSEHOLD_MEMBERS_ROSTER(i), strip(NAME(i)));
setocclabel(DEMOGRAPHICS_ROSTER(i), strip(NAME(i)));
setocclabel(EDUCATION_ROSTER(i), strip(NAME(i)));
setocclabel(FERTILITY_ROSTER(i), strip(NAME(i)));

enddo;
do numeric i = 1 while i <= totocc(DEATHS_ROSTER)
    setocclabel(DEATHS_ROSTER(i), strip(NAME_OF_DECEASED(i)));
enddo;
userbar(clear);
userbar(add button, "Hello", hello);
userbar(add button, "Go To...", goto);
userbar(add button, "Household Summary", household_summary);
userbar(add button,"Add Calculator",showCalculator);
userbar(add button, "View EA Map", showEAMap);
userbar(add button, "Capture GPS", getGPS);
userbar(add button, "View Household on Map", showHouseholdOnMap);
userbar(add button, "Household Report", showHouseholdReport);
userbar(show);


PROC POPSTAN2020_LEVEL

postproc
// Record interview end time when the questionnaire is completed.
if INTERVIEW_END_TIME = notappl then
    INTERVIEW_END_TIME = systime("HHMM");
endif;

// Capture the exact end timestamp and calculate duration.
if INTERVIEW_END_TIMESTAMP = notappl then
    INTERVIEW_END_TIMESTAMP = timestamp();

    INTERVIEW_DURATION_MINUTES =
       (INTERVIEW_END_TIMESTAMP - INTERVIEW_START_TIMESTAMP) / 60;
endif;
PROC INTERVIEW_START_TIME

preproc
// Prefill interview start time only once.
if visualvalue(INTERVIEW_START_TIME) = notappl then
    INTERVIEW_START_TIME = systime("HHMM");
endif;
// Capture the exact interview start timestamp once.
if visualvalue(INTERVIEW_START_TIMESTAMP) = notappl then
    INTERVIEW_START_TIMESTAMP = timestamp();
endif;
postproc
// Validate the entered time.
if START_HOUR > 23 or START_MINUTE > 59 then
    errmsg("Invalid time. Enter hours from 00 to 23 and minutes from 00 to 59.");
    reenter;
endif;
PROC DISTRICT
onfocus
numeric nextEntry = 1;

forcase ANN2_DISTRICT_CODES_DICT where DI_PROVINCE = PROVINCE do

    codes(nextEntry) = DI_DISTRICT;
    labels(nextEntry) = DI_DISTRICT_NAME;
    nextEntry = nextEntry + 1;

enddo;

codes(nextEntry) = notappl;
setvalueset(DISTRICT, codes, labels);

postproc
if loadcase(ANN2_DISTRICT_CODES_DICT, PROVINCE, DISTRICT) = 0 then
    errmsg("Invalid province and district combination.");
    reenter;
endif;
PROC PHOTO

onfocus

    photoFilename = pathname(Application) +
        maketext("../Data/HouseholdPhotos/photo%d%02d%03d%d%03d.jpg",
            PROVINCE, DISTRICT, ENUMERATION_AREA,
            AREA_TYPE, HOUSEHOLD_NUMBER);

    if fileexist(photoFilename) then
        setvalueset(PHOTO, PHOTO_VS_PHOTO_TAKEN);
    else
        setvalueset(PHOTO, PHOTO_VS_NO_PHOTO);
    endif;


postproc

    if PHOTO = 1 then
        execsystem(maketext("camera:%s", photoFilename));
        reenter;

    elseif PHOTO = 2 then
        execsystem(maketext("view:%s", photoFilename));
        reenter;

    elseif PHOTO = 3 then
        // Keep photograph and continue.

    elseif PHOTO = 9 then
        filedelete(photoFilename);

    endif;
PROC HOUSEHOLD_MEMBERS_ROSTER
postproc
// After demographics roster is complete, check to make sure that there is
// exactly one head of household
numeric numberOfHeads = count(PERSON_REC where RELATIONSHIP = 1);

if numberOfHeads <> 1 then
    errmsg("Number of heads of household must be exactly one");
    reenter RELATIONSHIP(1);
endif;


numeric numberOfSpouses = count(PERSON_REC where RELATIONSHIP = 2);

if numberOfSpouses > 0 and RELATIONSHIP(1) = 1 and MARITAL_STATUS(1) <> 2 then
    errmsg("The head of household has a spouse in the household but is not marked as married.");
    reenter MARITAL_STATUS(1);
endif;


do numeric i = 1 while i <= totocc(HOUSEHOLD_MEMBERS_ROSTER)

    if RELATIONSHIP(i) = 2 and SEX(i) = SEX(1) then
        errmsg("The head of household and spouse %s must not be the same sex.", strip(NAME(i)));
        reenter SEX(i);
    endif;

enddo;
PROC PERSON_NUMBER
preproc
//curocc() means:Give me the current occurrence number. for this field person number
PERSON_NUMBER = curocc();
noinput;
PROC NAME

setocclabel(HOUSEHOLD_MEMBERS_ROSTER, strip(NAME));
setocclabel(DEMOGRAPHICS_ROSTER, strip(NAME));
setocclabel(EDUCATION_ROSTER, strip(NAME));
setocclabel(FERTILITY_ROSTER, strip(NAME));
if curocc() = 1 then
// Set label for case in case listing to an easier to read format.
// We do this when we first get the name of the head.
string caseLabel = maketext("%d-%02d-%03d-%03d: %s", PROVINCE, DISTRICT, ENUMERATION_AREA,HOUSEHOLD_NUMBER, strip(NAME));
setcaselabel(POPSTAN2020_DICT, caseLabel);
endif;
PROC RELATIONSHIP
onfocus

if curocc() = 1 then
    setvalueset(RELATIONSHIP, RELATIONSHIP_VS1);
else
    if SEX = 1 then
        setvalueset(RELATIONSHIP, RELATIONSHIP_MALE);
    else
        setvalueset(RELATIONSHIP, RELATIONSHIP_FEMALE);
    endif;
endif;

postproc
// Don't allow non-head of household on first row
if RELATIONSHIP <> 1 and curocc() = 1 then
    errmsg("Please enter the head of household before the other household members.");
    reenter;
endif;
// Don't allow head of household on a row other than first row
if RELATIONSHIP = 1 and curocc() <> 1 then
   errmsg("Only one head of household is allowed. Head of household was already entered.");
   reenter;
endif;


PROC AGE

postproc
if RELATIONSHIP = 1 and AGE < 12 then
        errmsg(tr(100))
        select(tr(101), AGE,
              tr(102), RELATIONSHIP);
endif;

// Compare age of child to age of the head
if RELATIONSHIP = 3 and AGE(1) - AGE < 12 then
    errmsg("Child %s is %d years old but head %s is %d. Parent must be at least 12 years older than child.",
                strip(NAME),
                AGE,
                strip(NAME(1)),
                AGE(1))
                select("Correct age of " + strip(NAME), AGE,
                       "Correct age of " + strip(NAME(1)), AGE(1),
                       "Correct relationship of " + strip(NAME),
                       RELATIONSHIP,
                       "Correct relationship of " + strip(NAME(1)),
                       RELATIONSHIP(1));
    endif;


if RELATIONSHIP = 5 and AGE(1) - AGE < 24 then
    errmsg("Grandchild %s is %d years old, but head %s is %d. The head must be at least 24 years older than the grandchild.",
           strip(NAME),
           AGE,
           strip(NAME(1)),
           AGE(1))
           select("Correct grandchild age " + strip(NAME), AGE,
                  "Correct head age " + strip(NAME(1)), AGE(1),
                  "Correct grandchild relationship " + strip(NAME), RELATIONSHIP);
endif;
PROC DATE_OF_BIRTH
onfocus
numeric maxDay;

if DOB_MONTH = 2 then
    if (DOB_YEAR % 400 = 0) or((DOB_YEAR % 4 = 0) and(DOB_YEAR % 100 <> 0)) then 
	maxDay = 29;
      else
          maxDay = 28;
    endif;
elseif DOB_MONTH = 4 or
       DOB_MONTH = 6 or
       DOB_MONTH = 9 or
       DOB_MONTH = 11 then
    maxDay = 30;
else
    maxDay = 31;
endif;
do numeric i = 1 while i <= maxDay
    codes(i) = i;
    labels(i) = maketext("%d", i);
enddo;

setvalueset(DOB_DAY, codes, labels);
// Ensure that age matches date of birth
{
if AGE <> 999 and DATE_OF_BIRTH(curocc()) <> 99999999 then
    if datediff(DATE_OF_BIRTH(curocc()), INTERVIEW_DATE, "y") <> AGE then
        errmsg("Age (%d) doesn't match date of birth (%d). Based on date of birth age should be %d",
            AGE, DATE_OF_BIRTH(curocc()),
            datediff(DATE_OF_BIRTH(curocc()), INTERVIEW_DATE, "y"))
            select("Correct Age", AGE, "Correct date of birth",
                   DATE_OF_BIRTH);
    endif;
endif;
}
postproc
numeric calculatedAge = datediff(DATE_OF_BIRTH(curocc()), INTERVIEW_DATE, "y");
if calculatedAge <> AGE then
errmsg("Age (%d) does not match date of birth (%d). Based on date of birth age should be %d",
AGE, DATE_OF_BIRTH(curocc()), calculatedAge)
select("Correct Age", AGE, "Correct date of birth", DATE_OF_BIRTH);
endif;
PROC MARITAL_STATUS


preproc

if AGE < 12 then
    skip to MORE_PEOPLE;
endif;
{
if MARITAL_STATUS in 2:4 then
    errmsg("This person is or was married.");
endif;
}

//Ensure that spouse is not single, divorced or widowed
postproc
if MARITAL_STATUS in 1,3,4 and RELATIONSHIP = 2 then
    errmsg(tr("%s has relationship spouse and marital status %s. Spouse cannot be single, divorced or widowed."),
           strip(NAME(curocc())),
           getlabel(MARITAL_STATUS, MARITAL_STATUS))
    select(tr("Fix marital status"), MARITAL_STATUS,
           tr("Fix relationship"), RELATIONSHIP);
endif;

PROC MORE_PEOPLE


if MORE_PEOPLE = 2 then
    NUM_HH_MEMBERS = totocc(HOUSEHOLD_MEMBERS_ROSTER);
    endgroup;
endif;
PROC RESPONDENT_LINE_NUMBER
onfocus;
numeric IndexRoster;
numeric NextEntryValueSet=1;

do IndexRoster=1 while IndexRoster <= totocc(HOUSEHOLD_MEMBERS_ROSTER)
     
	 if AGE(IndexRoster) >= 12 then
	    labels(NextEntryValueSet)=NAME(IndexRoster);
		codes(NextEntryValueSet)=IndexRoster;
	    NextEntryValueSet = NextEntryValueSet +1;
		
	endif;
enddo;
codes(NextEntryValueSet) = notappl;
setvalueset(RESPONDENT_LINE_NUMBER,codes,labels);
PROC PLACE_OF_BIRTH
onfocus

// Declare a variable used to loop through place codes (1 to 5).
numeric i;

// Tracks the next available position in the dynamic value set.
// It ensures that valid choices are stored consecutively.
numeric nextChoice;

// Start placing choices at position 1 in the arrays.
nextChoice = 1;

// Loop through all five possible place codes.
do i = 1 while i <= 5

    // Check whether the current place belongs to the selected region:
    // Region 1 allows Nairobi (code 1).
    // Region 2 allows Mombasa (code 2).
    // Region 3 allows Kisumu (code 3).
    // Region 4 allows Nakuru (code 4) and Uasin Gishu (code 5).
    if (PRACTICE_REGION = 1 and i = 1) or
       (PRACTICE_REGION = 2 and i = 2) or
       (PRACTICE_REGION = 3 and i = 3) or
       (PRACTICE_REGION = 4 and i in 4,5) then

        // Store the actual answer code in the next available position.
        // For example, code 4 represents Nakuru.
		
        codes(nextChoice) = i;
        labels(nextChoice) = getlabel(PLACE_OF_BIRTH_SOURCE, i);
        // Assign the display label corresponding to the current code.
        // The label is what the interviewer sees on the screen.
		
{
        if i = 1 then
            labels(nextChoice) = "NAIROBI";
        elseif i = 2 then
            labels(nextChoice) = "MOMBASA";
        elseif i = 3 then
            labels(nextChoice) = "KISUMU";
        elseif i = 4 then
            labels(nextChoice) = "NAKURU";
        elseif i = 5 then
            labels(nextChoice) = "UASIN GISHU";
        endif;
}
        // Move to the next array position so the next valid choice
        // does not overwrite the choice just stored.
        nextChoice = nextChoice + 1;

    endif;

enddo;

// Mark the end of the list of valid codes.
// This is important because some regions have fewer choices than others.
codes(nextChoice) = notappl;

// Apply the codes and labels we created to PLACE_OF_BIRTH.
// The question now displays only choices allowed by PRACTICE_REGION.
setvalueset(PLACE_OF_BIRTH, codes ,labels);
PROC SIGN_LANGUAGE

preproc
    ask if pos("B", DISABILITIES) > 0;
PROC CITIZENSHIP
postproc
if curocc()=1 or RELATIONSHIP =2 then 
   skip to LANGUAGES_SPOKEN;
