PROC DEATH_RELATIONSHIP



PROC EVER_GIVEN_BIRTH

preproc
    if SEX = 1 or AGE < 12 or AGE > 50 then
        skip to next;
    endif;

postproc
    if EVER_GIVEN_BIRTH = 2 then
        skip to next;
    endif;
PROC NUMBER_CHILDREN_BORN


postproc
    if NUMBER_CHILDREN_BORN = 0 then
        errmsg("Number of children cannot be zero if she has given birth.");
        reenter;
    endif;
PROC CHILDREN_CURRENTLY_LIVING


postproc
    if CHILDREN_CURRENTLY_LIVING > NUMBER_CHILDREN_BORN then
        errmsg("Children currently living cannot be greater than children ever born.");
        reenter;
    endif;
PROC CHILDREN_DIED
onfocus
if EVER_GIVEN_BIRTH = 1 then
    calculatedChildrenDied = NUMBER_CHILDREN_BORN - CHILDREN_CURRENTLY_LIVING;
endif;
postproc
    if CHILDREN_DIED + CHILDREN_CURRENTLY_LIVING <> NUMBER_CHILDREN_BORN then
        errmsg("Children living plus children who died must equal children ever born.");
        reenter;
    endif;
PROC POSSESSIONS_PURCHASED_WITH_LOAN

onfocus
// Create dynamic value set from assets with quantity > 0
numeric nextEntry = 1;
string alphabet = "ABCDEFGHIJ";

do numeric assetNumber = 1 while assetNumber <= totocc(POSSESSIONS_ROSTER)
   
    // Check if household possesses this asset
    if QUANTITY(assetNumber) > 0 then

        // Add the asset label
       labels(nextEntry) = strip(ASSET_NAME(assetNumber));
        // Add the corresponding checkbox code
        codesString(nextEntry) = alphabet[assetNumber:1];

        nextEntry = nextEntry + 1;

    endif;

enddo;

// Mark the end of the alpha codes
codesString(nextEntry) = "";
// Apply the dynamic checkbox value set
setvalueset($, codesString, labels);
postproc

PROC INTERVIEW_END_TIME
preproc
if visualvalue(INTERVIEW_END_TIME) = notappl then
    INTERVIEW_END_TIME = systime("HHMM");
endif;
