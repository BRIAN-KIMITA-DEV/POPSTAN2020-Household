PROC MOTHER_ALIVE

PROC MOTHER_LINE_NUMBER

preproc
if MOTHER_ALIVE = 2 then
    MOTHER_LINE_NUMBER = 88;
    noinput;
endif;

onfocus
if MOTHER_ALIVE = 1 then

    numeric nextEntry = createMothersValueSet(curocc());

    codes(nextEntry) = 98;
    labels(nextEntry) = "Not a household member";

    nextEntry = nextEntry + 1;
    codes(nextEntry) = notappl;

    setvalueset($, codes, labels);
endif;

PROC LANGUAGES_SPOKEN


// Ensure that at least one language is chosen.
if length(strip(LANGUAGES_SPOKEN)) = 0 then
    errmsg("You must choose at least one language");
    reenter;
endif;
PROC MAIN_LANGUAGE
onfocus

// Start adding valid choices at position 1.
numeric nextEntry = 1;

// The checkbox codes A-E correspond to numeric codes 1-5.
string languageCheckboxCodes = "ABCDE";

// Check each possible language.
do numeric languageNumericCode = 1 while languageNumericCode <= 5

    // Convert numeric code to its checkbox letter.
    string languageCheckboxCode = languageCheckboxCodes[languageNumericCode:1];

    // Include the language only if it was selected earlier.
    if pos(languageCheckboxCode, LANGUAGES_SPOKEN) > 0 then

        // Store its numeric code.
        codes(nextEntry) = languageNumericCode;

        // Retrieve its label from MAIN_LANGUAGE's original value set.
       labels(nextEntry) = getlabel(MAIN_LANGUAGE_SOURCE, languageNumericCode);

        // Move to the next available array position.
        nextEntry = nextEntry + 1;

    endif;

enddo;

// Mark the end of the available choices.
codes(nextEntry) = notappl;

// Apply the filtered value set.
setvalueset(MAIN_LANGUAGE, codes, labels);
PROC OTHER_LANGUAGE

preproc
    ask if pos("E", LANGUAGES_SPOKEN) > 0;
PROC CHILDREN_IN_HOUSEHOLD
postproc
if BOYS_IN_HOUSEHOLD + GIRLS_IN_HOUSEHOLD <> CHILDREN_IN_HOUSEHOLD then
    errmsg("Boys (%d) plus girls (%d) does not match total (%d).",
           BOYS_IN_HOUSEHOLD, GIRLS_IN_HOUSEHOLD, CHILDREN_IN_HOUSEHOLD )
        select("Correct boys", BOYS_IN_HOUSEHOLD,
               "Correct girls", GIRLS_IN_HOUSEHOLD,
               "Correct total", CHILDREN_IN_HOUSEHOLD);
endif;

